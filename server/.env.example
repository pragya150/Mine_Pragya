# Port the server runs on
PORT=3000

# SMTP settings — used to email you when someone submits the contact form.
# Leave these blank and the form will still work: messages are always saved
# to server/data/leads.json even if email sending isn't configured.
#
# Example using Gmail:
# 1. Turn on 2-Step Verification on your Google account
# 2. Create an "App Password" at https://myaccount.google.com/apppasswords
# 3. Use that 16-character app password below (NOT your normal Gmail password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=pragya.parashar02@gmail.com
SMTP_PASS=your_16_char_app_password
TO_EMAIL=pragya.parashar02@gmail.com

# Simple shared secret to view submitted leads at /api/leads?token=...
ADMIN_TOKEN=change_this_to_something_secret
